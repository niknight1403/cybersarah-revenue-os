# ─── Runtime-Konfiguration CyberSarah Revenue OS ───────────────────────────────
# Die echte .env liegt nur auf dem Server (Hetzner) und wird per
# /api/admin/env (X-Deploy-Token) aus dem GitHub-Workflow sync-env.yml
# aktualisiert. Nie echte Werte ins Repository committen.

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/cybersarah

# STRIPE (LIVE)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# AI KEYS
GEMINI_API_KEY=
GEMINI_BACKUP_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=sk-...
OPENAI_BACKUP_KEY=

# DIGISTORE24
DIGISTORE24_API_KEY=
DIGISTORE24_USERNAME=
DIGISTORE24_IPN_SECRET=
DIGISTORE24_VENDOR_ID=
DIGISTORE24_AFFILIATE_ID=

# MARKETING / E-MAIL
RESEND_API_KEY=
BEEHIIV_API_KEY=
MAILCHIMP_API_KEY=
ADMIN_EMAIL=

# SOCIAL
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=cybersarah_webhook
TELEGRAM_BOT_TOKEN=

# INFRASTRUKTUR & DEPLOYMENT
PORT=3000
SERVER_IP=
LIVE_MODE=true
SIMULATION_MODE=false
NODE_ENV=production
ALLOWED_ORIGINS=https://cybersarah-ki.de,https://www.cybersarah-ki.de
API_AUTH_TOKEN=change_me
VITE_API_AUTH_TOKEN=change_me
DEPLOY_TOKEN=change_me
VITE_API_URL=
