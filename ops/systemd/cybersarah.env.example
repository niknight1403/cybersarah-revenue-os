# Copy to /etc/cybersarah/cybersarah.env and protect with chmod 600.
# Never commit the populated production file.
NODE_ENV=production
PORT=3000
HARA_RUNTIME_ENABLED=true

# Required runtime secret; provide through the server secret store.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Required application secrets; placeholders only.
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
DEPLOY_TOKEN=REPLACE_WITH_DEPLOY_TOKEN

# HubSpot read-only CRM integration. Leave empty until the token is provisioned.
CONNECTOR_HUBSPOT_MODE=read_only
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_WEBHOOK_SECRET=
HUBSPOT_INFLUENCER_STAGE_PROPERTY=cybersarah_influencer_stage

# Optional health endpoint used by deployment scripts.
HEALTHCHECK_URL=http://127.0.0.1:3000/healthz
